import express from "express";
import { MongoClient } from "mongodb";
import dotenv from "dotenv";

dotenv.config();

const app = express();
const port = process.env.PORT || 3000;
const client = new MongoClient(process.env.MONGO_URI);

let db;

async function connectDB() {
  try {
    await client.connect();
    db = client.db("hindu-temples");
    console.log("Connected to MongoDB Atlas");
  } catch (err) {
    console.error("MongoDB connection error:", err);
  }
}

connectDB();

// Endpoint to fetch all temples
app.get("/temples", async (req, res) => {
  try {
    const temples = await db.collection("temples").find({}).toArray();
    res.json(temples);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// Optional: filter by district
app.get("/temples/filter", async (req, res) => {
  const { district } = req.query;
  try {
    const temples = await db
      .collection("temples")
      .find(district ? { district } : {})
      .toArray();
    res.json(temples);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

app.listen(port, () => {
  console.log(`API server listening at http://localhost:${port}`);
});
